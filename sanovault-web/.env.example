# Neon Postgres
# Use the pooled connection string for DATABASE_URL and the direct one for migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Social login (configured in Neon Console → Auth → Configuration, not as app env vars):
# Enable Google OAuth. Register the provider redirect URI as:
#   {NEON_AUTH_BASE_URL}/callback/google
# Add your app origins (e.g. http://localhost:3001, https://sanovault-web.vercel.app) as trusted domains.

# Cloudflare R2 document storage. Keep the bucket private; the app issues signed URLs.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sanovault-documents

# Groq AI
GROQ_API_KEY=your-groq-api-key
# Vision model used for scanned PDFs / images (Scout was deprecated 2026-07-17)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Transactional email (household invites). Optional — in-app invites still work without it.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=SanoVault <onboarding@resend.dev>
# Public app URL used in invite links (defaults to request origin if unset)
# NEXT_PUBLIC_APP_URL=https://app.sanovault.com

# Optional external OCR HTTP service (POST multipart file -> { "text": "..." }).
# On Vercel, OCR uses PDF text extraction + Groq vision (GROQ_API_KEY) instead of Docker.
# Do not set this to localhost in production.
# OCR_SERVICE_URL=https://your-ocr-service.example.com
