# Neon Postgres
# Use the pooled connection string for DATABASE_URL and the direct one for migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Cloudflare R2 document storage. Keep the bucket private; the app issues signed URLs.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sanovault-documents

# Groq AI
GROQ_API_KEY=your-groq-api-key

# OCR Service
OCR_SERVICE_URL=http://localhost:8080
