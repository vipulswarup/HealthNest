# Neon Postgres
# Use the pooled connection string for DATABASE_URL and the direct one for migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32

# Social login (configured in Neon Console → Auth → Configuration, not as app env vars):
# Sign in with Apple for the iOS app (not Neon Auth). Audience is the iOS bundle ID.
APPLE_BUNDLE_ID=com.sanovault.app
# Add your app origins (e.g. http://localhost:3001, https://sanovault-web.vercel.app) as trusted domains.

# Cloudflare R2 document storage. Keep the bucket private; the app issues signed URLs.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sanovault-documents

# Groq AI
GROQ_API_KEY=your-groq-api-key
# Vision model used for scanned PDFs / images (Scout was deprecated 2026-07-17)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Transactional email via Brevo (household invites and other system mail).
# Must be an API key from Brevo → SMTP & API → API keys (starts with xkeysib-).
# Do not use an SMTP key (xsmtpsib-); that only works for SMTP and causes "Key not found".
BREVO_API_KEY=xkeysib-xxxxxxxx
EMAIL_FROM=SanoVault <noreply@yourdomain.com>
# Public app URL used in invite links and email logo
NEXT_PUBLIC_APP_URL=https://www.sanovault.com

# Optional external OCR HTTP service (POST multipart file -> { "text": "..." }).
# On Vercel, OCR uses PDF text extraction + Groq vision (GROQ_API_KEY) instead of Docker.
# Do not set this to localhost in production.
# OCR_SERVICE_URL=https://your-ocr-service.example.com

# WhatsApp Cloud API inbound (optional, later). Leave empty until the bot is enabled.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Per-user hourly limits for costly operations. Full OCR is counted per
# document request (not per page) and processes pages in batches.
RATE_LIMIT_DOCUMENT_UPLOADS_PER_HOUR=20
RATE_LIMIT_OCR_INTAKE_PER_HOUR=30
RATE_LIMIT_OCR_FULL_PER_HOUR=15
RATE_LIMIT_AI_PER_HOUR=20
