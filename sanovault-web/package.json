{
  "name": "sanovault-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "init-db": "npm run db:migrate",
    "test:blood-summary": "tsx scripts/seed-and-test-blood-summary.ts",
    "test:blood-summary:unit": "tsx --test tests/reports/blood-summary.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@aws-sdk/s3-request-presigner": "3.1108.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.2.3",
    "next": "16.3.0",
    "pngjs": "^7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "unpdf": "^1.8.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "preact": "10.28.2"
  }
}
